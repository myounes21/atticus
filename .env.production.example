
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.3:70b

EMBEDDING_BACKEND=sentence_transformers
EMBEDDER_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
EMBEDDING_MODEL_CACHE_DIR=
EMBEDDING_FALLBACK_ENABLED=false
EMBEDDING_WARMUP_ON_STARTUP=false

LANGFUSE_PUBLIC_KEY=replace-with-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-langfuse-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false

QDRANT_HOST=qdrant
QDRANT_PORT=6333

ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_PASSWORD=replace-with-strong-elastic-password
ELASTIC_XPACK_SECURITY_ENABLED=true

REDIS_HOST=redis
REDIS_PORT=6379

APP_PORT=8000
FRONTEND_PORT=3000
APP_DOMAIN=your-domain.example
APP_ENV=production
ALLOWED_ORIGINS=["https://your-domain.example"]
DEMO_AUTH=false
ENABLE_SELF_REGISTER=false

UPLOAD_MAX_MB=20
UPLOAD_ALLOWED_EXTENSIONS=[".pdf", ".docx", ".txt", ".eml"]
MAX_CHAT_QUERY_CHARS=2500
MAX_CASE_NAME_CHARS=140
MAX_CLIENT_NAME_CHARS=140

RATE_LIMIT_LOGIN_REQUESTS=8
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_REQUESTS=30
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_REQUESTS=12
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=300

NEXT_PUBLIC_API_BASE_URL=https://your-domain.example
API_PROXY_BASE_URL=http://backend:8000
NEXT_PUBLIC_DEMO_AUTH=false
NEXT_PUBLIC_ENABLE_SELF_REGISTER=false

DATABASE_URL=postgresql://atticus:replace-with-strong-db-password@postgres:5432/atticus
POSTGRES_DB=atticus
POSTGRES_USER=atticus
POSTGRES_PASSWORD=replace-with-strong-db-password

JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=atticus-api
JWT_AUDIENCE=atticus-clients

