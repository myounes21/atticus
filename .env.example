# LLM
GROQ_API_KEY=

# Langfuse (optional)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# App
APP_PORT=8000
FRONTEND_PORT=3000
APP_DOMAIN=demo.example.com
APP_ENV=development
ALLOWED_ORIGINS=["http://localhost:3000"]
DEMO_AUTH=false
ENABLE_SELF_REGISTER=false

# Input and upload safety
UPLOAD_MAX_MB=20
UPLOAD_ALLOWED_EXTENSIONS=[".pdf", ".docx", ".txt", ".eml"]
MAX_CHAT_QUERY_CHARS=2500
MAX_CASE_NAME_CHARS=140
MAX_CLIENT_NAME_CHARS=140

# Rate limits
RATE_LIMIT_LOGIN_REQUESTS=8
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_REQUESTS=30
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_REQUESTS=12
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=300

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_PROXY_BASE_URL=http://backend:8000
NEXT_PUBLIC_DEMO_AUTH=false

# Database
DATABASE_URL=postgresql://atticus:atticus_dev@localhost:5432/atticus
POSTGRES_DB=atticus
POSTGRES_USER=atticus
POSTGRES_PASSWORD=replace-with-strong-db-password

# JWT
JWT_SECRET_KEY=replace-with-long-random-secret
JWT_ISSUER=atticus-api
JWT_AUDIENCE=atticus-clients

# Frontend
NEXT_PUBLIC_ENABLE_SELF_REGISTER=false
